{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "projects": {
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "doc-flow-api": {
      "type": "application",
      "root": "apps/doc-flow-api",
      "entryFile": "main",
      "sourceRoot": "apps/doc-flow-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/doc-flow-api/tsconfig.app.json"
      }
    },
    "ocr-worker": {
      "type": "application",
      "root": "apps/ocr-worker",
      "entryFile": "main",
      "sourceRoot": "apps/ocr-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ocr-worker/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  },
  "compilerOptions": {
    "assets": [
      {
        "include": "apps/doc-flow-api/views/**/*",
        "outDir": "dist/apps/doc-flow-api/views",
        "watchAssets": true
      }
    ]
  }
}
