{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "projects": {
    "common-logging": {
      "type": "library",
      "root": "libs/common-logging",
      "entryFile": "index",
      "sourceRoot": "libs/common-logging/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common-logging/tsconfig.lib.json"
      }
    },
    "common-types": {
      "type": "library",
      "root": "libs/common-types",
      "entryFile": "index",
      "sourceRoot": "libs/common-types/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common-types/tsconfig.lib.json"
      }
    },
    "common-worker": {
      "type": "library",
      "root": "libs/common-worker",
      "entryFile": "index",
      "sourceRoot": "libs/common-worker/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common-worker/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "doc-flow-api": {
      "type": "application",
      "root": "apps/doc-flow-api",
      "entryFile": "main",
      "sourceRoot": "apps/doc-flow-api/src",
      "compilerOptions": {
        "assets": ["views/**/*"],
        "tsConfigPath": "apps/doc-flow-api/tsconfig.app.json"
      }
    },
    "gg-auth": {
      "type": "application",
      "root": "apps/gg-auth",
      "entryFile": "main",
      "sourceRoot": "apps/gg-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gg-auth/tsconfig.app.json"
      }
    },
    "gg-gateway": {
      "type": "application",
      "root": "apps/gg-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gg-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gg-gateway/tsconfig.app.json"
      }
    },
    "gg-user": {
      "type": "application",
      "root": "apps/gg-user",
      "entryFile": "main",
      "sourceRoot": "apps/gg-user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gg-user/tsconfig.app.json"
      }
    },
    "object-detection-worker": {
      "type": "application",
      "root": "apps/object-detection-worker",
      "entryFile": "main",
      "sourceRoot": "apps/object-detection-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/object-detection-worker/tsconfig.app.json"
      }
    },
    "ocr-worker": {
      "type": "application",
      "root": "apps/ocr-worker",
      "entryFile": "main",
      "sourceRoot": "apps/ocr-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ocr-worker/tsconfig.app.json"
      }
    }
  },
  "compilerOptions": {
    "webpack": true
  }
}
