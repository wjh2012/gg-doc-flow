{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "paths": {
      "@app/common-guard": [
        "libs/common-guard/src"
      ],
      "@app/common-guard/*": [
        "libs/common-guard/src/*"
      ],
      "@app/common-logging": [
        "libs/common-logging/src"
      ],
      "@app/common-logging/*": [
        "libs/common-logging/src/*"
      ],
      "@app/common-types": [
        "libs/common-types/src"
      ],
      "@app/common-types/*": [
        "libs/common-types/src/*"
      ],
      "@app/common-worker": [
        "libs/common-worker/src"
      ],
      "@app/common-worker/*": [
        "libs/common-worker/src/*"
      ],
      "@app/database": [
        "libs/database/src"
      ],
      "@app/database/*": [
        "libs/database/src/*"
      ]
    }
  }
}