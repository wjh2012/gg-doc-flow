<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Task Dashboard</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        .container { max-width: 800px; margin: 0 auto; }
        .controls { margin-bottom: 20px; padding: 20px; background: #f5f5f5; border-radius: 8px; }
        button { padding: 10px 20px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; }
        button:hover { background: #0056b3; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; border-bottom: 1px solid #ddd; text-align: left; }
        th { background-color: #f8f9fa; }
        .status-SUCCESS { color: green; font-weight: bold; }
        .status-PENDING { color: orange; font-weight: bold; }
        .status-FAILED { color: red; font-weight: bold; }
        #connection-status { margin-left: 10px; font-size: 0.9em; color: green; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Task Dashboard</h1>
        
        <div class="controls">
            <button onclick="createTask()">Create New Task</button>
            <span id="connection-status">Connecting to SSE...</span>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody id="task-list">
                <!-- Tasks will be inserted here -->
            </tbody>
        </table>
    </div>

    <script>
        const statusSpan = document.getElementById('connection-status');
        const taskList = document.getElementById('task-list');

        // Initial Load (Recent 20 tasks)
        async function loadRecentTasks() {
            try {
                const response = await fetch('/api/task/recent?limit=20');
                const tasks = await response.json();
                tasks.forEach(task => updateOrAddTask(task));
            } catch (e) {
                console.error('Failed to load recent tasks', e);
            }
        }

        // Create Task
        async function createTask() {
            try {
                await fetch('/api/task/test', { method: 'GET' });
                console.log('Task creation requested');
            } catch (e) {
                alert('Failed to create task');
            }
        }

        // SSE Connection
        const eventSource = new EventSource('/api/task/sse');

        eventSource.onopen = () => {
            statusSpan.textContent = 'Connected to Real-time Stream';
            statusSpan.style.color = 'green';
        };

        eventSource.onerror = () => {
            statusSpan.textContent = 'Connection Lost (Reconnecting...)';
            statusSpan.style.color = 'red';
        };

        eventSource.onmessage = (event) => {
            const task = JSON.parse(event.data);
            console.log('Update received:', task);
            updateOrAddTask(task);
            
            // Highlight effect
            const row = document.getElementById(`row-${task.id}`);
            if(row) {
                row.style.backgroundColor = '#e8f5e9';
                setTimeout(() => row.style.backgroundColor = '', 1000);
            }
        };

        function updateOrAddTask(task) {
            const existingRow = document.getElementById(`row-${task.id}`);
            
            const html = `
                <td>${task.id.substring(0, 8)}...</td>
                <td>${task.task_type}</td>
                <td class="status-${task.status}">${task.status}</td>
                <td>${new Date(task.created_at).toLocaleString()}</td>
            `;

            if (existingRow) {
                existingRow.innerHTML = html;
            } else {
                const row = document.createElement('tr');
                row.id = `row-${task.id}`;
                row.innerHTML = html;
                // Prepend to show newest first
                taskList.insertBefore(row, taskList.firstChild);
            }
        }

        loadRecentTasks();
    </script>
</body>
</html>
